{
  "name": "holefactory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HoleFactory — dig, haul, automate. A mobile-first 3D isometric mining + factory game.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.json --noEmit",
    "purity": "node scripts/check-purity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run purity && npm run test"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "11.0.0",
    "three": "0.186.1",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
